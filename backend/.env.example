# Copy to backend/.env and fill in. backend/.env is git-ignored. Never commit real keys.

# â”€â”€ Database â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
DATABASE_URL=postgresql+psycopg://documind:documind@127.0.0.1:5433/documind
TEST_DATABASE_URL=postgresql+psycopg://documind:documind@127.0.0.1:5433/documind_test

# â”€â”€ Storage â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# local = files on this machine's disk (development). supabase = Supabase Storage (production).
STORAGE_BACKEND=local
STORAGE_DIR=./data/blobs
# Needed when STORAGE_BACKEND=supabase (server-side secrets, never shown to the browser):
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SECRET_KEY=
# SUPABASE_BUCKET=documents
MAX_UPLOAD_BYTES=52428800
MAX_PAGES=1000

# â”€â”€ Embedding (local, Sentence Transformers) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# EMBEDDER=fake uses a deterministic hashing embedder (no model download), handy for quick tries.
EMBEDDER=sentence_transformers
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
MODEL_DEVICE=auto
# Where models are downloaded (bge-m3 is ~2.3 GB). Leave empty for the Hugging Face default (~/.cache).
MODEL_CACHE_DIR=A:/documind/models
EMBED_BATCH_SIZE=16

# Hosted embeddings (production), instead of the local model above: Cloudflare Workers AI runs the
# same BAAI/bge-m3 for free (10,000 "neurons" per day; when used up, calls fail instead of charging).
# Needs your Cloudflare account id and an API token with the "Workers AI" permission.
# EMBEDDER=openai_compat
# EMBEDDING_BASE_URL=https://api.cloudflare.com/client/v4/accounts/<ACCOUNT_ID>/ai/v1
# EMBEDDING_API_KEY=
# EMBEDDING_MODEL=@cf/baai/bge-m3
# EMBEDDING_DIM=1024
# If the OpenAI-compatible endpoint answers in an unexpected format, use Cloudflare's native one instead:
# EMBEDDING_BASE_URL=https://api.cloudflare.com/client/v4/accounts/<ACCOUNT_ID>/ai
# EMBEDDING_API_STYLE=cloudflare
# Any other OpenAI-compatible provider works too (the vectors must have 1024 dimensions).

# â”€â”€ Chunking â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
CHUNK_MAX_TOKENS=350
CHUNK_OVERLAP_TOKENS=50

# â”€â”€ Retrieval / context â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
RETRIEVAL_CANDIDATES=50
CONTEXT_MAX_CHUNKS=6
CONTEXT_MAX_TOKENS=3000

# â”€â”€ LLM (Groq, OpenAI-compatible API) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
LLM_PROVIDER=openai_compat
LLM_BASE_URL=https://api.groq.com/openai/v1
GROQ_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
# json_schema (strict, gpt-oss models) or json_object (e.g. llama-3.3-70b-versatile)
LLM_STRUCTURED_MODE=json_schema
LLM_REASONING_EFFORT=low
LLM_TEMPERATURE=0
LLM_MAX_OUTPUT_TOKENS=1500
LLM_TIMEOUT_S=60
LLM_MAX_RETRIES=3

# Small, fast model for light jobs: rewriting follow-up questions, describing documents
LLM_LIGHT_MODEL=openai/gpt-oss-20b
# Who the assistant says created it (answers "who made you?"), and a link shown with it
APP_NAME=DocuMind AI
CREATOR_NAME=Saad
CREATOR_URL=

# â”€â”€ Demo accounts (self-service "Try the demo": private, limited, expiring) â”€â”€
DEMO_ENABLED=true
DEMO_MAX_DOCUMENTS=5
DEMO_MAX_TOTAL_BYTES=12000000
DEMO_MAX_QUESTIONS_PER_DAY=40
DEMO_MAX_CONVERSATIONS=20
DEMO_TTL_DAYS=7
DEMO_SIGNUPS_PER_IP_PER_DAY=3
DEMO_MAX_ACTIVE_ACCOUNTS=300
# Wrong access codes allowed per network in the window before it is blocked
AUTH_MAX_FAILURES=10
AUTH_FAILURE_WINDOW_MINUTES=15
# Any long random text: salts the hash under which visitors' network addresses are stored
IP_HASH_SALT=
# Any long random text: lets the daily cleanup job (Vercel cron) call /internal/cleanup. Empty = route disabled.
CRON_SECRET=

# â”€â”€ Worker â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
WORKER_POLL_INTERVAL_S=1.0
JOB_TIMEOUT_S=1800
# true = run the ingestion worker inside the API process (single-service hosting, e.g. Render free tier)
RUN_WORKER_IN_API=false
# true = serverless hosting (Vercel): index documents inside the upload request instead of a worker
INLINE_JOBS=false
# Database connection pool per process. Keep small on serverless (every function instance has its own).
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5

# â”€â”€ Browser access â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Origin(s) of the deployed frontend, comma-separated. Empty = CORS off (local dev uses a proxy).
# CORS_ORIGINS=https://your-app.vercel.app

LOG_LEVEL=INFO
