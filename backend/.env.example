# Copy to backend/.env and fill in. backend/.env is git-ignored. Never commit real keys.

# ── Database ─────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg://documind:documind@localhost:5433/documind
TEST_DATABASE_URL=postgresql+psycopg://documind:documind@localhost:5433/documind_test

# ── Storage ──────────────────────────────────────────────
STORAGE_DIR=./data/blobs
MAX_UPLOAD_BYTES=52428800
MAX_PAGES=1000

# ── Embedding (local, Sentence Transformers) ─────────────
# EMBEDDER=fake uses a deterministic hashing embedder (no model download), handy for quick tries.
EMBEDDER=sentence_transformers
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
MODEL_DEVICE=auto
# Where models are downloaded (bge-m3 is ~2.3 GB). Leave empty for the Hugging Face default (~/.cache).
MODEL_CACHE_DIR=A:/documind/models
EMBED_BATCH_SIZE=16

# ── Chunking ─────────────────────────────────────────────
CHUNK_MAX_TOKENS=350
CHUNK_OVERLAP_TOKENS=50

# ── Retrieval / context ──────────────────────────────────
RETRIEVAL_CANDIDATES=50
CONTEXT_MAX_CHUNKS=6
CONTEXT_MAX_TOKENS=3000

# ── LLM (Groq, OpenAI-compatible API) ────────────────────
LLM_PROVIDER=openai_compat
LLM_BASE_URL=https://api.groq.com/openai/v1
GROQ_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
# json_schema (strict, gpt-oss models) or json_object (e.g. llama-3.3-70b-versatile)
LLM_STRUCTURED_MODE=json_schema
LLM_REASONING_EFFORT=low
LLM_TEMPERATURE=0
LLM_MAX_OUTPUT_TOKENS=1500
LLM_TIMEOUT_S=60
LLM_MAX_RETRIES=3

# ── Worker ───────────────────────────────────────────────
WORKER_POLL_INTERVAL_S=1.0
JOB_TIMEOUT_S=1800

LOG_LEVEL=INFO
